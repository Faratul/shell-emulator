# Стартовый скрипт: тест всех команд этапов 1-3
# Запуск: ./run.sh --vfs src/vfs/deep.zip --script src/start
# Строки, начинающиеся с #, - комментарии; пустые строки пропускаются

# --- Этап 1: команды-заглушки и echo ---
ls
ls dir1 dir2        # комментарий после команды
cd /home/user
cd
echo hello world

# ошибка: неизвестная команда (скрипт продолжит работу)
unknown_cmd arg

# --- Этап 3: VFS (служебные команды) ---
# содержимое всей VFS: каталоги, файлы, тип и размер
vfs-info

# текстовые файлы (с ведущим / и без него)
vfs-dump /home/user/notes.txt
vfs-dump home/user/docs/archive/2024/log.txt

# двоичный файл выводится в base64
vfs-dump /bin/tool.bin

# --- Ошибки VFS ---
vfs-dump /no/such/file
vfs-dump /home/user/docs
vfs-dump

exit
