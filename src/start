# Стартовый скрипт: тест всех команд (этапы 1-4)
# Запуск: ./run.sh --vfs src/vfs/deep.zip --script src/start
# Строки, начинающиеся с #, - комментарии; пустые строки пропускаются

# ===== echo, неизвестная команда =====
echo hello world
unknown_cmd arg

# ===== ls =====
# без аргументов: корень VFS
ls
# подробный формат: тип, размер, имя
ls -l
# с путём: абсолютным и относительным
ls /home/user
ls etc
# пустой каталог
ls /tmp
# несколько путей сразу
ls /etc /bin
# файл вместо каталога
ls /etc/app.conf
# ошибки: нет такого пути, неверная опция
ls /no/such/dir
ls -z

# ===== cd =====
cd /home/user
ls
# относительный путь, вложенный на несколько уровней
cd docs/archive/2024
ls -l
# на уровень выше и через несколько уровней
cd ..
cd ../..
# . и .. выше корня остаются в корне
cd /
cd ../..
# без аргумента - в корень
cd /home/user/docs
cd
ls
# ошибки: файл, нет такого каталога, много аргументов
cd /etc/app.conf
cd /no/such/dir
cd /etc /bin

# ===== cat =====
cd /home/user
# текстовый файл (относительный и абсолютный путь)
cat notes.txt
cat /etc/app.conf
# несколько файлов подряд
cat docs/report.txt docs/archive/2024/log.txt
# двоичный файл выводится в base64
cat /bin/tool.bin
# ошибки: каталог, нет файла, без аргументов
cat docs
cat nofile.txt
cat

# ===== uname =====
uname
uname -s
uname -a
uname -s -r
uname -mn
# ошибки: неверная опция, лишний операнд
uname -x
uname extra

# ===== date =====
date
date -u
date +%Y-%m-%d
date +%H:%M
# ошибки: неверная опция, неверная дата
date -x
date tomorrow

# ===== служебные команды VFS (этап 3) =====
vfs-info
vfs-dump /home/user/notes.txt
vfs-dump /no/such/file
vfs-dump

exit
